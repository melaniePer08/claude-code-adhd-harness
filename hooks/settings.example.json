{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/github-check.mjs"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/session-log.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/session-start.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/rules-refresh.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/secret-scan.mjs"
            ],
            "timeout": 30,
            "statusMessage": "Checking for secrets"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/auto-push.mjs"
            ],
            "timeout": 120,
            "statusMessage": "Pushing to GitHub"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/auto-format.mjs"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/review-gate.mjs"
            ],
            "timeout": 20,
            "statusMessage": "Checking if a review is due"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/dep-check.mjs"
            ],
            "timeout": 90,
            "statusMessage": "Checking dependencies"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/commit-guard.mjs"
            ],
            "timeout": 30,
            "statusMessage": "Checking for uncommitted work"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/notify.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/finish-check.mjs"
            ],
            "timeout": 180,
            "statusMessage": "Running the project checks"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/session-log.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/session-log.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/block-dangerous.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/secret-scan.mjs"
            ],
            "timeout": 30,
            "statusMessage": "Checking for secrets"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/protect-secret-files.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/commit-guard.mjs"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/command-log.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/protect-config.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/require-remote.mjs"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent|Task|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/ram-check.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/explain-gate.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/notify.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/finish-check.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/mistake-log.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{HOOKS_DIR}}/notify.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}